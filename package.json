{
  "name": "agentswitch",
  "version": "0.1.0-dev.1",
  "description": "Find coding-agent sessions and carry conversations between agents.",
  "type": "module",
  "bin": { "agentswitch": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "docs", "CONTRIBUTING.md", "AGENTS.md"],
  "engines": { "node": ">=22.15" },
  "scripts": {
    "build": "tsc",
    "dev": "npm run build && node dist/cli.js",
    "check": "tsc --noEmit",
    "distribution:check": "node scripts/check-distribution.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "repository": { "type": "git", "url": "https://github.com/rammicz/agentswitch.git" },
  "bugs": { "url": "https://github.com/rammicz/agentswitch/issues" },
  "homepage": "https://github.com/rammicz/agentswitch#readme",
  "keywords": ["codex", "claude-code", "sessions", "tui", "handoff"],
  "author": "rammicz",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
